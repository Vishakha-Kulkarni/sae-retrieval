#!/bin/bash
# CPU/high-memory stage: build one full CL-SR index and evaluate validation.
# Submit once per variant after p3_encode_full.pbs completes:
#   qsub -P personal-riddhima -v REPO=...,DATA=...,VARIANT=fixed32 scripts/nscc/p3_index_eval.pbs
#   qsub -P personal-riddhima -v REPO=...,DATA=...,VARIANT=adaptive scripts/nscc/p3_index_eval.pbs
#PBS -N p3_index
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=110gb
#PBS -l walltime=24:00:00
#PBS -j oe
source "$PBS_O_WORKDIR/scripts/nscc/env.sh"
set -euo pipefail

: "${VARIANT:?Set VARIANT to fixed32 or adaptive}"
P3_OUT=${P3_OUT:-$DATA/p3_full_eval}
case "$VARIANT" in
    fixed32)
        PASSAGE_LATENTS="$P3_OUT/fixed32.passages.jsonl"
        REPORT="$P3_OUT/fixed32.validation.json"
        ;;
    adaptive)
        PASSAGE_LATENTS="$P3_OUT/adaptive.passages.jsonl"
        REPORT="$P3_OUT/adaptive.validation.json"
        ;;
    *) echo "Unknown VARIANT: $VARIANT" >&2; exit 2 ;;
esac

for path in "$PASSAGE_LATENTS" "$P3_OUT/validation.query.json" "$DATA/qrels.train.tsv"; do
    test -f "$path" || { echo "Missing required input: $path" >&2; exit 2; }
done

mkdir -p "$P3_OUT/tmp"
export TMPDIR="$P3_OUT/tmp"
python -m p3.evaluate_index --passage-latents "$PASSAGE_LATENTS" \
    --query-latents "$P3_OUT/validation.query.json" --qrels "$DATA/qrels.train.tsv" \
    --output "$REPORT"
