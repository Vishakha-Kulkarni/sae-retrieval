#!/bin/bash
# Released CL-SR scoring (vectorised p2.clsr, verified score-for-score against upstream latent_retrieve.py),
# then upstream cl-sr/evaluate.py unchanged. Paper target (k=32, CL-SR Efficient): MRR@10 0.343 on dev-small.
# qsub -P personal-riddhima -v TAG=B0[,SPLITS="dev dl19 dl20"] scripts/nscc/clsr_fast.pbs   (CHECK_RUN=<upstream run>: parity on dev)
#PBS -N p2_clsrfast
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=04:00:00
#PBS -j oe
source "$PBS_O_WORKDIR/scripts/nscc/env.sh"
set -euo pipefail
LAT="$HOME/scratch/sae/latents/$TAG"
UP="$REPO/upstream/Decoding-Dense-Embeddings/cl-sr"
MAXL=${MAX_LATENTS:-24}
mkdir -p "$LAT/fast_max$MAXL"
# SPLITS: any of dev (MS MARCO dev-small, MRR@10) dl19 dl20 (TREC DL, NDCG@10); default dev only.
for split in ${SPLITS:-dev}; do
    [ -e "$LAT/$split.query.json" ] || { echo "skip $split: no $LAT/$split.query.json"; continue; }
    if [ "$split" = dev ]; then qrels="$RAW/qrels.dev.small.tsv"; else qrels="$DATA/$split.qrels"; fi
    python -m p2.clsr --passage-latents "$LAT/passages.latent.jsonl" --query-latents "$LAT/$split.query.json" \
        --output "$LAT/fast_max$MAXL/$split.tsv" --max-latents "$MAXL" \
        ${CHECK_RUN:+$([ "$split" = dev ] && echo --check-run "$CHECK_RUN")}
    ln -sf "$qrels" "$LAT/${split}_qrels.txt"   # upstream evaluate.py reads <eval_data>_qrels.txt
    (cd "$LAT" && python "$UP/evaluate.py" --eval_data "$split" --result_path "$LAT/fast_max$MAXL/$split.tsv" \
        | tee "$LAT/clsr_fast_max$MAXL.$split.metrics.txt")
done
